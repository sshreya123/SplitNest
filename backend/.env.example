APP_NAME=SplitNest API
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/splitnest_db
JWT_SECRET_KEY=replace_with_a_secure_random_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=splitnest_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax